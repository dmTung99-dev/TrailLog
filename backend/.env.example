# Copy to .env for local development.
DATABASE_URL="postgresql://traillog:traillog@localhost:5433/traillog"
# Any value works locally; production refuses to start with this placeholder.
JWT_SECRET="replace-with-a-long-random-value"

# "local" writes photos to UPLOAD_DIR (default ./uploads); "s3" uses any
# S3-compatible bucket (Cloudflare R2 in staging) and needs the S3_* values.
STORAGE_DRIVER="local"
# UPLOAD_DIR="./uploads"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="traillog-staging"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
