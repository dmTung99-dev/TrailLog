# Copy to .env.local (gitignored) for the "local" build variant.
APP_ENV=local
# Your PC's LAN address (find it with `ipconfig`), where `docker compose up`
# in backend/ serves the API. The phone must be on the same Wi-Fi.
API_BASE_URL=http://192.168.1.x:3000
# Optional for development: without a key the route map renders blank.
GOOGLE_MAPS_API_KEY=
